{
  "name": "jhb-curtain-cleaning-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:site": "npm --prefix curtain-site run install:ci",
    "dev": "npm --prefix curtain-site run dev",
    "build": "npm --prefix curtain-site run build",
    "start": "npm --prefix curtain-site run start",
    "lint": "npm --prefix curtain-site run lint",
